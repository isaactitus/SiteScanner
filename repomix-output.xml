  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script src="/render.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      if (window.authReady) await window.authReady;
      if (!currentUser) return window.location.href = "/";

      // 1. Render Billing UI (Clinical Data Display)
      const planUi = document.getElementById("planStatusUi");
      if (currentUser.is_pro) {
        let daysRemaining = 30;
        let progressPercent = 0;
        
        if (currentUser.pro_started_at) {
          let dbDateStr = currentUser.pro_started_at;
          if (!dbDateStr.includes("T")) dbDateStr = dbDateStr.replace(" ", "T");
          if (!dbDateStr.endsWith("Z")) dbDateStr += "Z";
          
          const startDate = new Date(dbDateStr);
          if (!isNaN(startDate.getTime())) {
            const now = new Date();
            const diffDays = Math.max(0, (now - startDate) / (1000 * 60 * 60 * 24));
            const cycleDay = diffDays % 30; 
            daysRemaining = Math.max(1, Math.ceil(30 - cycleDay));
            progressPercent = Math.round((cycleDay / 30) * 100);
          }
        }

        planUi.innerHTML = `
          <span style="display: inline-block; padding: 4px 10px; background: rgba(129, 140, 248, 0.1); color: var(--brand-purple); border: 1px solid rgba(129, 140, 248, 0.2); border-radius: 4px; font-weight: 800; font-family: var(--font-mono); font-size: 0.75rem; margin-bottom: 16px;">PRO_TIER</span>
          <div style="font-size: 0.95rem; color: var(--text-secondary);">Cycle renews in <strong style="color: #fff; font-family: var(--font-mono); font-size: 1.1rem;">${daysRemaining} Days</strong></div>
          <div style="width: 100%; height: 4px; background: var(--bg); border: 1px solid var(--surface-border); border-radius: 9999px; margin-top: 16px; overflow: hidden;">
            <div style="width: ${progressPercent}%; height: 100%; background: var(--brand-purple); border-radius: 9999px;"></div>
          </div>`;
      } else {
        planUi.innerHTML = `
          <span style="display: inline-block; padding: 4px 10px; background: var(--surface-subtle); color: var(--text-secondary); border: 1px solid var(--surface-border); border-radius: 4px; font-weight: 800; font-family: var(--font-mono); font-size: 0.75rem; margin-bottom: 16px;">FREE_TIER</span>
          <div style="font-size: 0.95rem; color: var(--text-tertiary); line-height: 1.6;">Account restricted to manual passive execution.</div>
          <button onclick="window.launchRazorpayCheckout('Unlimited Dashboards', () => window.location.reload())" class="cta-button" style="width: 100%; margin-top: 24px; background: #fff; color: #000; border: none;">Authorize Upgrade</button>
        `;
      }

      loadMonitors();

      async function loadMonitors() {
        const listEl = document.getElementById("monitorsList");
        try {
          const res = await fetch("/api/monitors");
          const monitors = await res.json();

          if (monitors.length === 0) {
            document.getElementById("monitorCount").textContent = "[ 0 ACTIVE ]";
            listEl.innerHTML = `
              <div style="padding: 80px 32px; text-align: center;">
                <strong style="color: #fff; display: block; font-size: 1.1rem; margin-bottom: 12px; font-family: var(--font-mono);">[ TELEMETRY_INACTIVE ]</strong>
                <p style="color: var(--text-secondary); font-size: 0.95rem; max-width: 400px; margin: 0 auto 32px; line-height: 1.6;">Execute a baseline infrastructure audit on any domain and configure alerts to establish continuous background telemetry.</p>
                <a href="/" class="cta-button" style="display: inline-flex; width: auto; background: #fff; color: #000; text-decoration: none;">Execute Baseline Scan</a>
              </div>`;
            return;
          }

          const activeMonitors = monitors.filter(m => m.is_active);
          document.getElementById("monitorCount").textContent = `[ ${activeMonitors.length} ACTIVE ]`;
          
          if (activeMonitors.length > 0) {
            const validScores = activeMonitors.map(m => m.last_score).filter(s => s !== null);
            if (validScores.length > 0) {
              const avg = Math.round(validScores.reduce((a,b)=>a+b,0) / validScores.length);
              const avgEl = document.getElementById("avgScoreDisplay");
              avgEl.textContent = avg;
              avgEl.style.color = avg >= 75 ? "var(--brand-emerald)" : avg >= 40 ? "var(--brand-amber)" : "var(--brand-rose)";
            }
          }

          listEl.innerHTML = monitors.map(m => {
            const scoreColor = m.last_score >= 75 ? 'var(--brand-emerald)' : m.last_score >= 40 ? 'var(--brand-amber)' : 'var(--brand-rose)';
            const rowClass = m.is_active ? 'monitor-row' : 'monitor-row inactive';
            
            return `
            <div class="${rowClass}" id="monitor-row-${m.id}">
              <div>
                <span class="monitor-title" id="title-${m.id}">${m.hostname}</span>
                <div style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--text-secondary); display: flex; gap: 16px; align-items: center;">
                  <span>SCORE: <strong style="color: ${m.last_score ? scoreColor : 'var(--text-tertiary)'}">${m.last_score || 'PENDING'}</strong></span>
                  <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--surface-border-hover);"></span>
                  <span>ALERT_THRESHOLD: <strong style="color: #cbd5e1;">&lt; ${m.alert_threshold}</strong></span>
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 24px;">
                <a href="/report/${encodeURIComponent(m.hostname)}" style="font-size: 0.8rem; color: var(--brand-cyan); text-decoration: none; font-weight: 700; font-family: var(--font-mono); letter-spacing: 0.05em; transition: opacity 0.2s;" onmouseover="this.style.opacity=0.7" onmouseout="this.style.opacity=1">[ DIAGNOSTICS ]</a>
                
                <label class="toggle-switch">
                  <input type="checkbox" class="optimistic-toggle" data-id="${m.id}" data-active="${m.is_active ? '1' : '0'}" ${m.is_active ? 'checked' : ''}>
                  <div class="toggle-slider"></div>
                </label>

                <button class="action-btn-text delete-monitor-btn" data-id="${m.id}" title="Remove Target Infrastructure">[ DELETE ]</button>
              </div>
            </div>`;
          }).join("");

          // --- DELETE LOGIC (CLINICAL MODAL) ---
          document.querySelectorAll('.delete-monitor-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              const id = e.target.getAttribute('data-id');
              const hostname = document.getElementById(`title-${id}`).textContent.trim();
              
              if (document.getElementById("deleteModal")) document.getElementById("deleteModal").remove();
              
              const modalHtml = `
                <div id="deleteModal" style="position:fixed; inset:0; background:rgba(10, 14, 23, 0.85); backdrop-filter:blur(8px); display:flex; align-items:center; justify-content:center; z-index:9999; padding:20px; animation: floatUpFade 0.3s var(--ease-float);">
                  <div class="card" style="max-width:440px; width:100%; border:1px solid var(--surface-border); text-align:center; padding:40px 32px;">
                    <span style="font-family: var(--font-mono); font-weight: 700; color: var(--brand-rose); font-size: 0.8rem; letter-spacing: 0.05em; display: block; margin-bottom: 16px;">[ DESTRUCTIVE ACTION ]</span>
                    <h3 style="color:#fff; font-size:1.4rem; font-weight:700; margin-bottom:12px; letter-spacing: -0.02em;">Purge Infrastructure Monitor</h3>
                    <p style="color:var(--text-secondary); font-size:0.95rem; line-height:1.6; margin-bottom:32px;">Are you sure you want to permanently unbind telemetry for <strong>${hostname}</strong>? This will instantly halt all background workers and purge the schedule.</p>
                    <div style="display:flex; gap: 16px;">
                      <button id="confirmDeleteBtn" class="cta-button" style="background:var(--brand-rose); color:#000; border-color:var(--brand-rose); flex:1;">Execute Deletion</button>
                      <button id="cancelDeleteBtn" class="cta-button" style="background:transparent; border-color:var(--surface-border); flex:1;">Cancel</button>
                    </div>
                  </div>
                </div>
              `;
              
              document.body.insertAdjacentHTML("beforeend", modalHtml);
              
              document.getElementById("cancelDeleteBtn").onclick = () => {
                document.getElementById("deleteModal").remove();
              };
              
              document.getElementById("confirmDeleteBtn").onclick = async () => {
                const confirmBtn = document.getElementById("confirmDeleteBtn");
                confirmBtn.disabled = true;
                confirmBtn.textContent = "Executing...";
                
                try {
                  const res = await fetch(`/api/monitors/${id}`, { method: 'DELETE' });
                  const data = await res.json();
                  if (!res.ok || data.error) throw new Error(data.error || "Delete execution failed");
                  
                  document.getElementById("deleteModal").remove();
                  loadMonitors(); 
                  
                } catch (err) {
                  alert("System Error: " + err.message);
                  confirmBtn.disabled = false;
                  confirmBtn.textContent = "Execute Deletion";
                }
              };
            });
          });

          // --- TOGGLE LOGIC (CLINICAL MODAL) ---
          document.querySelectorAll('.optimistic-toggle').forEach(input => {
            input.addEventListener('click', (e) => {
              e.preventDefault(); 

              const id = input.getAttribute('data-id');
              const hostname = document.getElementById(`title-${id}`).textContent.trim();
              const isCurrentlyActive = input.getAttribute('data-active') === '1';
              const row = document.getElementById(`monitor-row-${id}`);

              if (isCurrentlyActive) {
                if (document.getElementById("disableModal")) document.getElementById("disableModal").remove();
                const modalHtml = `
                  <div id="disableModal" style="position:fixed; inset:0; background:rgba(10, 14, 23, 0.85); backdrop-filter:blur(8px); display:flex; align-items:center; justify-content:center; z-index:9999; padding:20px; animation: floatUpFade 0.3s var(--ease-float);">
                    <div class="card" style="max-width:440px; width:100%; border:1px solid var(--surface-border); text-align:center; padding:40px 32px;">
                      <span style="font-family: var(--font-mono); font-weight: 700; color: var(--brand-amber); font-size: 0.8rem; letter-spacing: 0.05em; display: block; margin-bottom: 16px;">[ WARNING: COOLDOWN PROTOCOL ]</span>
                      <h3 style="color:#fff; font-size:1.4rem; font-weight:700; margin-bottom:12px; letter-spacing: -0.02em;">Halt Telemetry Engine</h3>
                      <p style="color:var(--text-secondary); font-size:0.95rem; line-height:1.6; margin-bottom:32px;">Halting active analysis enforces a strict 24-hour network cooldown for <strong>${hostname}</strong> to prevent abuse. Proceed with suspension?</p>
                      <div style="display:flex; gap: 16px;">
                        <button id="confirmDisableBtn" class="cta-button" style="background:var(--brand-amber); color:#000; border-color:var(--brand-amber); flex:1;">Suspend Engine</button>
                        <button id="cancelDisableBtn" class="cta-button" style="background:transparent; border-color:var(--surface-border); flex:1;">Abort</button>
                      </div>
                    </div>
                  </div>
                `;
                document.body.insertAdjacentHTML("beforeend", modalHtml);

                document.getElementById("cancelDisableBtn").onclick = () => {
                  document.getElementById("disableModal").remove();
                };

                document.getElementById("confirmDisableBtn").onclick = async () => {
                  document.getElementById("disableModal").remove();
                  await executeToggle(id, false, input, row);
                };
              } else {
                executeToggle(id, true, input, row);
              }
            });
          });

          async function executeToggle(id, willBeActive, checkboxEl, rowEl) {
            checkboxEl.checked = willBeActive;
            if (willBeActive) rowEl.classList.remove('inactive');
            else rowEl.classList.add('inactive');

            try {
              const res = await fetch(`/api/monitors/${id}/toggle`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isActive: willBeActive })
              });
              const data = await res.json();
              if (!res.ok || data.error) throw new Error(data.error || "Failed to mutate monitor state");

              checkboxEl.setAttribute('data-active', willBeActive ? '1' : '0');
              checkboxEl.checked = willBeActive;

              const activeCount = document.querySelectorAll('.optimistic-toggle[data-active="1"]').length;
              document.getElementById("monitorCount").textContent = `[ ${activeCount} ACTIVE ]`;

            } catch (err) {
              alert("System Error: " + err.message);
              const prevActive = checkboxEl.getAttribute('data-active') === '1';
              checkboxEl.checked = prevActive;
              if (prevActive) rowEl.classList.remove('inactive');
              else rowEl.classList.add('inactive');
            }
          }

        } catch (err) {
          listEl.innerHTML = `<div style="padding: 24px; color: var(--brand-rose); text-align: center; font-family: var(--font-mono);">[ SYSTEM_FAULT: ${err.message} ]</div>`;
        }
      }
    });

    // --- BILLING MODAL (CLINICAL UI) ---
    window.showBillingModal = function() {
      if (document.getElementById("billingModal")) document.getElementById("billingModal").remove();
      
      let startedDate = "Pending Sync";
      if (currentUser.pro_started_at) {
         let dStr = currentUser.pro_started_at;
         if (!dStr.includes("T")) dStr = dStr.replace(" ", "T");
         if (!dStr.endsWith("Z")) dStr += "Z";
         startedDate = new Date(dStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      }
      
      const modalHtml = `
        <div id="billingModal" style="position:fixed; inset:0; background:rgba(10, 14, 23, 0.85); backdrop-filter:blur(8px); display:flex; align-items:center; justify-content:center; z-index:9999; padding:20px; animation: floatUpFade 0.3s var(--ease-float);">
          <div class="card" style="max-width:480px; width:100%; border:1px solid var(--surface-border); padding:40px 32px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
              <h3 style="color:#fff; font-size:1.4rem; font-weight:800; letter-spacing: -0.02em;">Billing Configuration</h3>
              <span style="padding:4px 10px; background:rgba(52,211,153,0.1); color:var(--brand-emerald); border-radius:4px; font-size:0.75rem; font-weight:800; font-family: var(--font-mono); border:1px solid rgba(52,211,153,0.2);">[ ACTIVE_SUBSCRIPTION ]</span>
            </div>
            
            <div style="background: var(--surface-subtle); padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--surface-border); margin-bottom: 24px;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 16px;">
                <span style="color: var(--text-tertiary); font-size: 0.9rem;">Service Tier</span>
                <span style="color: #fff; font-weight: 700; font-size: 0.9rem;">SiteScanner PRO</span>
              </div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 16px;">
                <span style="color: var(--text-tertiary); font-size: 0.9rem;">Recurring Charge</span>
                <span style="color: #fff; font-weight: 700; font-size: 0.9rem;">₹499.00 / month</span>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-tertiary); font-size: 0.9rem;">Provision Date</span>
                <span style="color: #fff; font-weight: 700; font-size: 0.9rem;">${startedDate}</span>
              </div>
            </div>

            <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.6; margin-bottom:28px;">To modify your payment mechanism or suspend your subscription, authenticate via the secure Razorpay customer gateway.</p>
            
            <div style="display:flex; gap: 16px;">
              <button id="portalBtn" class="cta-button" style="background:#fff; color:#000; border:none; flex:1; font-weight:700;">Payment Gateway</button>
              <button id="closeBillingModal" type="button" class="cta-button" style="background:transparent; border-color:var(--surface-border); flex:1;">Dismiss</button>
            </div>
          </div>
        </div>`;
      
      document.body.insertAdjacentHTML("beforeend", modalHtml); 
      document.getElementById("closeBillingModal").onclick = () => document.getElementById("billingModal").remove();
      document.getElementById("portalBtn").onclick = () => {
          alert("[ SYSTEM NOTICE ] In a production environment, this button will dispatch a secure redirect to the Razorpay Customer Portal.");
          document.getElementById("billingModal").remove();
      };
    };
  </script>
  <script>document.addEventListener('DOMContentLoaded', () => { window.initSiteHeader(); window.initNavDock(); });</script>
