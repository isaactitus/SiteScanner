</head>
<body>
  <div class="app-container" style="max-width: 900px;">

    <header style="margin-bottom: 32px;">
      <h1 style="font-size: 2.2rem; font-weight: 800; color: #fff; margin-bottom: 8px;">Audit History</h1>
      <p style="color: var(--text-secondary);">A private log of all security assessments executed by your account.</p>
    </header>

    <main class="card" style="padding: 0; overflow: hidden; border-color: var(--surface-border-hover);">
      <div class="history-row history-header">
        <span>Target Domain</span>
        <span>Score</span>
        <span>Grade</span>
        <span style="text-align: right;">Date Executed</span>
      </div>
      <div id="historyList">
        <div style="padding: 48px; text-align: center; color: var(--text-tertiary);">Loading encrypted logs...</div>
      </div>
    </main>
  </div>

  <script src="/render.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      if (window.authReady) await window.authReady;
      if (!currentUser) return window.location.href = "/";

      window.initSiteHeader();
      window.initNavDock();

      try {
        const res = await fetch("/api/user-history");
        const scans = await res.json();
        const list = document.getElementById("historyList");

        if (scans.length === 0) {
          list.innerHTML = `<div style="padding: 48px; text-align: center; color: var(--text-secondary);">You haven't run any audits while signed in yet.</div>`;
          return;
        }

        list.innerHTML = scans.map(s => {
          const scoreColor = s.score >= 75 ? 'var(--brand-emerald)' : s.score >= 40 ? 'var(--brand-amber)' : 'var(--brand-rose)';
          
          // Parse the date and extract both Date and Time separately
          const scanDate = new Date(s.scanned_at.replace(" ", "T") + "Z");
          const dateStr = scanDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          const timeStr = scanDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
          
          return `
            <a href="/report/${encodeURIComponent(s.hostname)}" class="history-row">
              <span style="color: #fff; font-weight: 600; font-family: var(--font-mono);">${s.hostname}</span>
              <span style="color: ${scoreColor}; font-weight: 700;">${s.score} / 100</span>
              <span style="color: ${scoreColor}; font-weight: 800;">${s.grade}</span>
              <div style="text-align: right; display: flex; flex-direction: column; gap: 2px;">
                <span style="color: var(--text-secondary); font-size: 0.85rem; font-weight: 600;">${dateStr}</span>
                <span style="color: var(--text-tertiary); font-size: 0.75rem;">${timeStr}</span>
              </div>
            </a>
          `;
        }).join('');
      } catch (err) {
        document.getElementById("historyList").innerHTML = `<div style="padding: 24px; color: var(--brand-rose); text-align: center;">Error loading history.</div>`;
      }
    });
  </script>
</body>
</html>
