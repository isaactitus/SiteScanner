        <div class="card" style="padding: 0; overflow: hidden; border: 1px solid var(--surface-border);">
          <div style="background: var(--surface-subtle); padding: 24px 32px; border-bottom: 1px solid var(--surface-border); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; letter-spacing: -0.01em;">Automated Threat Telemetry</h3>
            <span style="font-size: 0.75rem; font-weight: 700; font-family: var(--font-mono); color: var(--text-secondary); background: var(--bg); padding: 6px 12px; border-radius: 9999px; border: 1px solid var(--surface-border);" id="monitorCount">[ 0 ACTIVE ]</span>
          </div>
          
          <div id="monitorsList">
            <div style="padding: 80px 32px; text-align: center; color: var(--text-tertiary); font-family: var(--font-mono); font-size: 0.85rem;">
              <span style="display:inline-block; animation: pulse 2s infinite ease-in-out;">[ ESTABLISHING_SECURE_CONNECTION... ]</span>
            </div>
          </div>
        </div>
      </section>
