/* public/style.css */

/* ==========================================================================
   BASE & VARIABLES (CLINICAL DARK MODE)
   ========================================================================== */
:root {
  --bg: #0a0e17;
  --surface: #111827;
  --surface-subtle: #1f2937;
  --surface-border: #374151;
  --surface-border-hover: #4b5563;
  --text-primary: #f9fafb;
  --text-secondary: #9ca3af;
  --text-tertiary: #6b7280;
  --brand-cyan: #38bdf8;
  --brand-purple: #818cf8;
  --brand-emerald: #34d399;
  --brand-rose: #fb7185;
  --brand-amber: #fbbf24;
  
  --radius-lg: 12px;
  --radius-md: 8px;
  --radius-sm: 4px;
  --shadow-float: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
  
  --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  
  /* Anti-Gravity Curve */
  --ease-float: cubic-bezier(0.2, 0.8, 0.2, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background-color: var(--bg);
  color: var(--text-primary);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  line-height: 1.6;
}

.app-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 32px 80px;
}

/* ANTI-GRAVITY LOAD ANIMATIONS */
@keyframes floatUpFade {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

.omnibox-container { opacity: 0; animation: floatUpFade 0.8s var(--ease-float) 0.1s forwards; }
#homepage-defaults { opacity: 0; animation: floatUpFade 0.8s var(--ease-float) 0.2s forwards; }

/* ==========================================================================
   OMNIBOX & SEARCH
   ========================================================================== */
.omnibox-container {
  max-width: 720px;
  margin: 0 auto 64px;
}

.omnibox-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: 9999px; /* Complete pill shape */
  padding: 6px 6px 6px 24px;
  transition: all 0.5s var(--ease-float);
}

.omnibox-wrapper:focus-within {
  border-color: var(--text-tertiary);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  transform: translateY(-2px);
}

.omnibox-icon { 
  color: var(--text-secondary); 
  display: flex; 
  align-items: center; 
}

.omnibox-input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 14px 16px;
  font-size: 1.05rem;
  color: #fff;
  outline: none;
  font-family: var(--font-mono);
}

.omnibox-btn {
  background: var(--surface-border-hover);
  color: #fff;
  font-weight: 600;
  font-size: 0.95rem;
  padding: 14px 32px;
  border: none;
  border-radius: 9999px;
  cursor: pointer;
  transition: all 0.4s var(--ease-float);
  white-space: nowrap;
}

.omnibox-btn:hover {
  transform: scale(1.02);
}

.omnibox-options {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-top: 20px;
  font-size: 0.85rem;
  color: var(--text-tertiary);
}

/* ==========================================================================
   AUDIT SELECTION CARDS (HOMEPAGE)
   ========================================================================== */
.audit-type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 32px;
  text-align: left;
}

@media (max-width: 600px) {
  .audit-type-grid { grid-template-columns: 1fr; }
}

.audit-card {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-md);
  padding: 24px;
  cursor: pointer;
  transition: all 0.3s var(--ease-float);
  position: relative;
}

.audit-card:hover {
  border-color: var(--surface-border-hover);
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}

.audit-card.active {
  border-color: var(--brand-emerald);
  background: rgba(52, 211, 153, 0.05);
}

.audit-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.audit-card-header h3 {
  color: #fff;
  font-size: 1.05rem;
  font-weight: 600;
}

.radio-indicator {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid var(--surface-border);
  transition: all 0.3s ease;
}

.audit-card.active .radio-indicator {
  border-color: var(--brand-emerald);
  border-width: 5px;
}

.audit-card p {
  color: var(--text-secondary);
  font-size: 0.85rem;
  line-height: 1.6;
  margin-bottom: 20px;
}

.audit-tag {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-tertiary);
  letter-spacing: 0.05em;
}

.pro-badge {
  background: rgba(52, 211, 153, 0.15);
  color: var(--brand-emerald);
  border: 1px solid rgba(52, 211, 153, 0.3);
  font-size: 0.65rem;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 4px;
  font-family: var(--font-mono);
}

/* ==========================================================================
   RESULTS & METRICS (CLINICAL VIEW)
   ========================================================================== */
.results-area { display: flex; flex-direction: column; gap: 16px; }

.card {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 24px 32px;
  transition: all 0.5s var(--ease-float);
}

.hero-grade-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface-subtle);
  border: 1px solid var(--surface-border);
  padding: 32px 40px;
}

.hero-grade-left { display: flex; align-items: center; gap: 32px; }

.grade-ring {
  width: 80px;
  height: 80px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grade-ring svg { transform: rotate(-90deg); width: 100%; height: 100%; }
.grade-ring-bg { fill: none; stroke: var(--surface-border); stroke-width: 6; }
.grade-ring-fg { fill: none; stroke-width: 6; stroke-linecap: round; transition: stroke-dashoffset 1.5s var(--ease-float); }

.grade-ring-letter { position: absolute; font-size: 2rem; font-weight: 700; }
.hero-score-title { font-size: 1.5rem; font-weight: 600; color: #fff; letter-spacing: -0.01em; }

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid var(--surface-border);
  font-size: 0.95rem;
}

.result-item:last-child { border-bottom: none; }

.status-badge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 9999px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-family: var(--font-mono);
}

.status-ok { background: rgba(52, 211, 153, 0.1); color: var(--brand-emerald); }
.status-warn { background: rgba(251, 191, 36, 0.1); color: var(--brand-amber); }
.status-bad { background: rgba(251, 113, 133, 0.1); color: var(--brand-rose); }

/* Control Buttons */
.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
  margin-top: 12px;
}

.cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 14px 24px;
  background: var(--surface-subtle);
  border: 1px solid var(--surface-border);
  border-radius: 9999px;
  color: #fff;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.4s var(--ease-float);
}

.cta-button:hover {
  background: var(--surface-border-hover);
  transform: translateY(-3px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}

.cta-button:active { transform: translateY(0); box-shadow: none; }

.ai-card {
  border: 1px solid var(--surface-border) !important;
  background: var(--bg) !important;
  padding: 40px 32px !important;
}

/* ==========================================
   MARKDOWN RENDER STYLES & TYPOGRAPHY CAP
   ========================================== */
.report { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.7; }
.report p, .report ul, .report ol { max-width: 85ch; margin-bottom: 1.2em; }
.report h1, .report h2, .report h3, .report h4 { color: #fff; margin-top: 1.8em; margin-bottom: 0.6em; line-height: 1.3; font-weight: 600; }
.report ul, .report ol { padding-left: 24px; }
.report li { margin-bottom: 0.5em; }
.report code { background: var(--surface-subtle); padding: 2px 6px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.85em; color: var(--text-primary); border: 1px solid var(--surface-border); }
.report pre { background: #000; border: 1px solid var(--surface-border); padding: 20px; border-radius: var(--radius-md); overflow-x: auto; margin-bottom: 1.2em; }
.report pre code { background: transparent; padding: 0; color: var(--text-secondary); border: none; }

/* ==========================================================================
   TOGGLES & SWITCHES (CLINICAL iOS STYLE)
   ========================================================================== */
.toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; }
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-slider {
  position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
  background-color: var(--surface-subtle); border: 1px solid var(--surface-border);
  transition: .4s var(--ease-float); border-radius: 34px;
}
.toggle-slider:before {
  position: absolute; content: ""; height: 18px; width: 18px; left: 2px; bottom: 2px;
  background-color: var(--text-secondary); transition: .4s var(--ease-float); border-radius: 50%;
}
.toggle-switch input:checked + .toggle-slider {
  background-color: rgba(52, 211, 153, 0.15); border-color: var(--brand-emerald);
}
.toggle-switch input:checked + .toggle-slider:before {
  transform: translateX(20px); background-color: var(--brand-emerald); box-shadow: 0 0 10px rgba(52, 211, 153, 0.4);
}

/* Enterprise Print CSS */
@media print {
  body, html, .card { background: #fff !important; color: #000 !important; border-color: #ccc !important; }
  .omnibox-container, .action-grid, #nav-dock { display: none !important; }
}

/* ==========================================================================
   TOP SITE HEADER BAR
   ========================================================================== */
#site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 52px;
  z-index: 8500;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px 0 24px;
  background: rgba(10, 14, 23, 0.72);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
  box-shadow: 0 1px 0 rgba(255,255,255,0.03), 0 4px 24px rgba(0,0,0,0.4);
  animation: headerSlideDown 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

@keyframes headerSlideDown {
  from { opacity: 0; transform: translateY(-100%); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Brand wordmark */
.site-header-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  flex-shrink: 0;
}

.site-header-brand-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 16px rgba(56, 189, 248, 0.35);
  flex-shrink: 0;
}

.site-header-brand-icon svg {
  width: 15px;
  height: 15px;
  stroke: #000;
  fill: none;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.site-header-brand-name {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.site-header-brand-name span {
  background: linear-gradient(90deg, #38bdf8, #818cf8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Centre area — context / page label */
.site-header-context {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}

.site-header-context-sep {
  width: 1px;
  height: 12px;
  background: rgba(255,255,255,0.12);
}

/* Right — live stats cluster */
.site-header-stats {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-shrink: 0;
}

.site-header-stat {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  color: var(--text-tertiary);
  text-transform: uppercase;
}

.site-header-stat strong {
  color: #fff;
  font-weight: 700;
}

/* Pulsing live status dot */
.header-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--brand-emerald);
  box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
  animation: headerLivePulse 2s infinite ease-out;
  flex-shrink: 0;
}

@keyframes headerLivePulse {
  0%   { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); }
  70%  { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
  100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
}

.header-scan-count {
  transition: all 0.4s var(--ease-float);
}

/* Thin divider between header stat items */
.site-header-divider {
  width: 1px;
  height: 16px;
  background: rgba(255, 255, 255, 0.08);
}

/* Push all page content below the header */
body { padding-top: 52px; }

/* Print — hide header */
@media print {
  #site-header { display: none !important; }
}

/* Hide on tiny screens */
@media (max-width: 480px) {
  .site-header-stats { display: none; }
  .site-header-context { display: none; }
}

/* ==========================================================================
   VERTICAL NAV DOCK — Luxury Vehicle / SaaS Dashboard Style
   ========================================================================== */
#nav-dock {
  position: fixed;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 9000;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  background: rgba(17, 24, 39, 0.75);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 9999px;
  padding: 16px 10px;
  box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.6),
              inset 0 1px 0 rgba(255, 255, 255, 0.04);
  animation: dockSlideIn 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

@keyframes dockSlideIn {
  from { opacity: 0; transform: translateY(-50%) translateX(-16px); }
  to   { opacity: 1; transform: translateY(-50%) translateX(0); }
}

/* Thin separator line */
.dock-sep {
  width: 20px;
  height: 1px;
  background: rgba(255, 255, 255, 0.07);
  margin: 4px 0;
  border-radius: 1px;
}

/* Each dock item wrapper */
.dock-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: transparent;
  cursor: pointer;
  transition: background 0.25s var(--ease-float),
              transform 0.25s var(--ease-float);
  color: var(--text-tertiary);
  outline: none;
  text-decoration: none;
}

.dock-item svg {
  width: 18px;
  height: 18px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.75;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: stroke 0.25s, filter 0.25s;
  flex-shrink: 0;
}

.dock-item:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  transform: scale(1.12);
}

/* Active state — cyan glow */
.dock-item.dock-active {
  background: rgba(56, 189, 248, 0.1);
  color: var(--brand-cyan);
}
.dock-item.dock-active svg {
  filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.55));
}

/* Active state — emerald glow (home on index) */
.dock-item.dock-active-home {
  background: rgba(52, 211, 153, 0.1);
  color: var(--brand-emerald);
}
.dock-item.dock-active-home svg {
  filter: drop-shadow(0 0 6px rgba(52, 211, 153, 0.55));
}

/* Tooltip */
.dock-item::after {
  content: attr(data-tip);
  position: absolute;
  left: calc(100% + 14px);
  top: 50%;
  transform: translateY(-50%) translateX(-6px);
  background: rgba(17, 24, 39, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #fff;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
  padding: 5px 10px;
  border-radius: 6px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s, transform 0.2s;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}

.dock-item:hover::after {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

/* Dock modal backdrop */
.dock-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(10, 14, 23, 0.8);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9500;
  padding: 20px;
  animation: floatUpFade 0.25s var(--ease-float) forwards;
}

.dock-modal {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 40px 36px;
  max-width: 480px;
  width: 100%;
  box-shadow: var(--shadow-float);
  position: relative;
}

.dock-modal-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 12px;
  display: block;
}

.dock-modal h3 {
  color: #fff;
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 8px;
}

.dock-modal p {
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.7;
  margin-bottom: 24px;
}

.dock-modal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid var(--surface-border);
  font-size: 0.9rem;
}

.dock-modal-row:last-of-type { border-bottom: none; }

.dock-modal-key { color: var(--text-secondary); }
.dock-modal-val { color: #fff; font-weight: 600; font-family: var(--font-mono); }

.dock-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: transparent;
  border: none;
  color: var(--text-tertiary);
  cursor: pointer;
  font-size: 1.1rem;
  line-height: 1;
  padding: 6px;
  border-radius: 4px;
  transition: color 0.2s;
}
.dock-modal-close:hover { color: #fff; }

/* Hide dock on very small screens */
@media (max-width: 640px) {
  #nav-dock { display: none; }
}
