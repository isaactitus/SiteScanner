    document.addEventListener('DOMContentLoaded', () => {
      window.initSiteHeader();
      window.initNavDock();

      // ── Load / refresh intel cards from localStorage ─────────
      function mountIntelPanel(data) {
        const layout  = document.getElementById('homepage-layout');
        const cards   = document.getElementById('intel-cards');
        const heading = document.getElementById('homepage-heading');
        if (!data || !window.renderIntelCards) return;
        cards.innerHTML = window.renderIntelCards(data);
        layout.classList.add('has-intel');
        if (heading) heading.style.textAlign = 'left';
      }

      // Expose so app.js can call after each scan
      window._refreshIntelPanel = function() {
        try {
          const cached = localStorage.getItem('lastScannedData');
          if (cached) mountIntelPanel(JSON.parse(cached));
        } catch(e) {}
      };

      // Restore on page load
      window._refreshIntelPanel();

      // Show/hide [ CLEAR ] based on whether results section has content
      const resultsEl = document.getElementById('results');
      const clearBtn  = document.getElementById('intel-clear-btn');

      function syncClearBtn() {
        // Hide clear button whenever a scan is running or results are displayed
        clearBtn.style.display = resultsEl && resultsEl.children.length > 0 ? 'none' : 'block';
      }

      // Watch results section for DOM mutations
      const resultObserver = new MutationObserver(syncClearBtn);
      if (resultsEl) resultObserver.observe(resultsEl, { childList: true, subtree: false });
      syncClearBtn(); // run once on load

      // Clear button
      document.getElementById('intel-clear-btn').onclick = () => {
        localStorage.removeItem('lastScannedData');
        document.getElementById('homepage-layout').classList.remove('has-intel');
        const h = document.getElementById('homepage-heading');
        if (h) h.style.textAlign = 'center';
        document.getElementById('intel-cards').innerHTML = '';
      };
    });
  </script>
