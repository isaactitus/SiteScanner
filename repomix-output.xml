<body>
<div class="wrap">
  <h1>🔍 SiteScanner</h1>
  <p class="sub">Free passive security health check for your website. No exploits, no attacks — just checks.</p>

  <!-- Quick Check: one field, one clear answer, no technical detail -->
  <div class="card">
    <strong style="display:block; margin-bottom:10px;">Quick Check — is this site safe?</strong>
    <input type="text" id="quickInput" placeholder="yourdomain.com" />
    <label class="confirm">
      <input type="checkbox" id="quickConfirm" />
      I own this domain or have explicit permission to check it.
    </label>
    <button id="quickBtn">Check Now</button>
    <div id="quickResult"></div>
  </div>

  <div class="card">
    <strong style="display:block; margin-bottom:10px;">Full Technical Scan</strong>
    <input type="text" id="urlInput" placeholder="yourdomain.com" />
    <label class="confirm">
      <input type="checkbox" id="confirmOwn" />
      I own this domain or have explicit permission to scan it.
    </label>
    <label class="confirm">
      <input type="checkbox" id="listPublicly" />
      List this scan on the public "Recently scanned" feed
    </label>
    <button id="scanBtn">Scan Now</button>
  </div>

  <div id="recentFeed"></div>

  <div id="results"></div>
</div>

<script src="/render.js"></script>
<script>
// Public "Recently scanned" feed — opt-in only, shown on homepage
async function loadRecentFeed() {
  const feedEl = document.getElementById('recentFeed');
  try {
    const res = await fetch('/api/recent');
    const feed = await res.json();
    if (!feed.length) { feedEl.innerHTML = ''; return; }

    const gradeColor = g => ({ A: '#4ade80', B: '#4ade80', C: '#fbbf24', D: '#fbbf24', F: '#f87171' }[g] || 'var(--muted)');
    let html = `<div class="card"><strong>Recently Scanned (public, opt-in)</strong>`;
    feed.forEach(item => {
      html += `<div class="result-item"><span><a href="/report/${item.hostname}" style="color:var(--text);">${item.hostname}</a></span><span class="status" style="color:${gradeColor(item.grade)};">${item.grade} (${item.score})</span></div>`;
    });
    html += `</div>`;
    feedEl.innerHTML = html;
  } catch {
    feedEl.innerHTML = '';
  }
}
loadRecentFeed();

// Quick Check logic — simple safe/unsafe answer, no technical detail
const quickBtn = document.getElementById('quickBtn');
const quickResultEl = document.getElementById('quickResult');

quickBtn.addEventListener('click', async () => {
  const url = document.getElementById('quickInput').value.trim();
  const confirmed = document.getElementById('quickConfirm').checked;

  if (!url) return alert('Enter a domain first.');
  if (!confirmed) return alert('Please confirm you have permission to check this domain.');

  quickBtn.disabled = true;
  quickResultEl.innerHTML = '<div class="loading">Checking…</div>';

  try {
    const res = await fetch('/api/quickcheck', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, ownershipConfirmed: confirmed }),
    });
    const data = await res.json();

    if (data.error) {
      quickResultEl.innerHTML = `<div style="color:var(--bad); margin-top:12px;">${data.error}</div>`;
      quickBtn.disabled = false;
      return;
    }

    const color = data.safe ? 'var(--accent)' : 'var(--bad)';
    const label = data.safe ? '✅ Safe' : '⚠️ Unsafe';
    let html = `<div style="margin-top:16px; padding:16px; border-radius:10px; background:${data.safe ? 'rgba(74,222,128,0.1)' : 'rgba(248,113,113,0.1)'}; border:1px solid ${color};">`;
    html += `<div style="font-size:1.4rem; font-weight:700; color:${color};">${label}</div>`;
    if (!data.safe && data.reasons.length > 0) {
      html += `<ul style="margin:8px 0 0 18px; color:var(--muted); font-size:0.9rem;">`;
      data.reasons.forEach(r => html += `<li>${r}</li>`);
      html += `</ul>`;
    }
    html += `<a href="#" id="wantFullReport" style="display:inline-block; margin-top:12px; color:var(--accent); font-size:0.9rem;">Want the full technical report? →</a>`;
    html += `</div>`;
    quickResultEl.innerHTML = html;

    document.getElementById('wantFullReport').addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('urlInput').value = url;
      document.getElementById('confirmOwn').checked = true;
      document.getElementById('urlInput').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  } catch (err) {
    quickResultEl.innerHTML = `<div style="color:var(--bad); margin-top:12px;">Check failed: ${err.message}</div>`;
  }
  quickBtn.disabled = false;
});

const btn = document.getElementById('scanBtn');
const resultsEl = document.getElementById('results');

btn.addEventListener('click', () => {
  const url = document.getElementById('urlInput').value.trim();
  const confirmed = document.getElementById('confirmOwn').checked;
  const listPublicly = document.getElementById('listPublicly').checked;

  if (!url) return alert('Enter a domain first.');
  if (!confirmed) return alert('Please confirm you have permission to scan this domain.');

  btn.disabled = true;
  resultsEl.innerHTML = `
    <div class="card scan-pulse-wrap">
      <div class="scan-pulse">
        <div class="pulse-ring"></div>
        <div class="pulse-ring delay1"></div>
        <div class="pulse-ring delay2"></div>
        <div class="pulse-core"></div>
      </div>
      <div class="scan-pulse-label" id="scanStatusLabel">Starting scan…</div>
      <div id="scanStatusList" style="margin-top:14px; font-size:0.85rem; color:var(--muted); text-align:left;"></div>
    </div>`;

  const statusLabel = document.getElementById('scanStatusLabel');
  const statusList = document.getElementById('scanStatusList');
  const doneChecks = [];

  const params = new URLSearchParams({ url, confirmed: 'true', listPublicly: String(listPublicly) });
  const source = new EventSource('/api/scan-stream?' + params.toString());

  source.addEventListener('progress', (e) => {
    const { label, status } = JSON.parse(e.data);
    doneChecks.push({ label, status });
    statusLabel.textContent = `Scanning ${url}… (${doneChecks.length}/9)`;
    statusList.innerHTML = doneChecks
      .map(c => `<div>${c.status === 'done' ? '✓' : '⚠'} ${c.label}</div>`)
      .join('');
  });

  source.addEventListener('done', (e) => {
    const data = JSON.parse(e.data);
    source.close();
    renderResults(data);
    applyStaggeredFadeIn(resultsEl);
    resultsEl.insertAdjacentHTML('afterbegin', `<div class="card" style="text-align:center;">🔗 <a href="/report/${data.hostname}" target="_blank" style="color:var(--accent);">Shareable link to this report →</a></div>`);
    loadRecentFeed();
    btn.disabled = false;
  });

  source.addEventListener('error', () => {
    if (source.readyState === EventSource.CLOSED) return; // already closed cleanly after 'done', ignore
    source.close();
    resultsEl.innerHTML = `<div class="card bad">Scan failed or connection lost. Please try again.</div>`;
    btn.disabled = false;
  });
});
</script>
</body>
</html>
