<file path="public/style.css">
:root {
  --bg: #090d16;
  --surface: #0f172a;
  --surface-subtle: #131d35;
  --surface-border: #1e293b;
  --surface-border-hover: #334155;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-tertiary: #64748b;
  --brand-cyan: #06b6d4;
  --brand-purple: #8b5cf6;
  --brand-emerald: #10b981;
  --brand-rose: #f43f5e;
  --brand-amber: #f59e0b;
  --radius-lg: 16px;
  --radius-md: 10px;
  --radius-sm: 6px;
  --shadow-glow: 0 0 30px -10px rgba(6, 182, 212, 0.15);
  --shadow-purple: 0 0 30px -8px rgba(139, 92, 246, 0.25);
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg);
  background-image: 
    radial-gradient(ellipse 80% 50% at 50% -20%, rgba(14, 165, 233, 0.15), transparent 70%),
    radial-gradient(ellipse 60% 40% at 50% 120%, rgba(139, 92, 246, 0.1), transparent 70%);
  color: var(--text-primary);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  line-height: 1.5;
}

.app-container {
  max-width: 880px;
  margin: 0 auto;
  padding: 32px 20px 80px;
}

/* Nav Header */
.app-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #fff;
  text-decoration: none;
}

.nav-brand-badge {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--brand-cyan);
  box-shadow: 0 0 10px var(--brand-cyan);
  display: inline-block;
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}

.nav-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.03);
  padding: 6px 12px;
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.nav-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--brand-emerald);
}

/* Hero Section */
.hero {
  text-align: center;
  margin-bottom: 40px;
}

.hero-title {
  font-size: 2.75rem;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.035em;
  background: linear-gradient(180deg, #ffffff 40%, #94a3b8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 14px;
}

.hero-subtitle {
  color: var(--text-secondary);
  font-size: 1.05rem;
  max-width: 540px;
  margin: 0 auto;
}

/* Scan Dock */
.scan-card {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), var(--shadow-glow);
  margin-bottom: 32px;
  transition: border-color 0.2s ease;
}

.tab-group {
  display: flex;
  gap: 8px;
  background: rgba(0, 0, 0, 0.25);
  padding: 4px;
  border-radius: var(--radius-md);
  margin-bottom: 20px;
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.tab-btn {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 600;
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab-btn.active {
  background: var(--surface-subtle);
  color: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.input-group {
  position: relative;
  display: flex;
  gap: 10px;
  margin-bottom: 14px;
}

.scan-input {
  flex: 1;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-md);
  padding: 14px 18px;
  font-size: 0.95rem;
  color: #fff;
  outline: none;
  font-family: var(--font-mono);
  transition: all 0.2s ease;
}

.scan-input:focus {
  border-color: var(--brand-cyan);
  box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.2);
}

.scan-btn {
  background: #fff;
  color: #090d16;
  font-weight: 700;
  font-size: 0.95rem;
  padding: 0 28px;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.scan-btn:hover {
  background: #e2e8f0;
  transform: translateY(-1px);
}

.scan-btn:active {
  transform: translateY(0);
}

.scan-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 0.8rem;
  color: var(--text-tertiary);
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  user-select: none;
}

.checkbox-label input {
  accent-color: var(--brand-cyan);
  border-radius: 4px;
  cursor: pointer;
}

/* Feed Ticker (Hidden Scrollbar) */
.feed-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(15, 23, 42, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.05);
  padding: 12px 18px;
  border-radius: var(--radius-md);
  margin-bottom: 36px;
  font-size: 0.85rem;
}

.feed-title {
  color: var(--text-tertiary);
  font-weight: 600;
  white-space: nowrap;
  margin-right: 12px;
}

.feed-items {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.feed-items::-webkit-scrollbar {
  display: none;
}

.feed-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.03);
  padding: 4px 10px;
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  color: var(--text-secondary);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  text-decoration: none;
  white-space: nowrap;
  transition: border-color 0.2s;
}

.feed-chip:hover {
  border-color: var(--brand-cyan);
  color: #fff;
}

.feed-chip-grade {
  font-weight: 800;
}

/* Results & Metrics */
.results-area {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.card {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 20px 24px;
  animation: slideUp 0.35s ease-out forwards;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.hero-grade-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(19, 29, 53, 0.7) 100%);
  border: 1px solid var(--surface-border-hover);
  padding: 28px 32px;
}

.hero-grade-left {
  display: flex;
  align-items: center;
  gap: 24px;
}

.grade-ring {
  width: 90px;
  height: 90px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grade-ring svg {
  transform: rotate(-90deg);
  width: 100%;
  height: 100%;
}

.grade-ring-bg {
  fill: none;
  stroke: rgba(255, 255, 255, 0.05);
  stroke-width: 8;
}

.grade-ring-fg {
  fill: none;
  stroke-width: 8;
  stroke-linecap: round;
  transition: stroke-dashoffset 1s ease-out;
}

.grade-ring-letter {
  position: absolute;
  font-size: 2.2rem;
  font-weight: 800;
}

.hero-score-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
}

.hero-score-delta {
  font-size: 0.85rem;
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.summary-badges {
  display: flex;
  gap: 12px;
}

.summary-pill {
  padding: 6px 14px;
  border-radius: 9999px;
  font-size: 0.8rem;
  font-weight: 600;
  font-family: var(--font-mono);
}

.pill-critical { background: rgba(244, 63, 94, 0.15); color: var(--brand-rose); border: 1px solid rgba(244, 63, 94, 0.2); }
.pill-warning { background: rgba(245, 158, 11, 0.15); color: var(--brand-amber); border: 1px solid rgba(245, 158, 11, 0.2); }
.pill-passed { background: rgba(16, 185, 129, 0.15); color: var(--brand-emerald); border: 1px solid rgba(16, 185, 129, 0.2); }

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  font-size: 0.9rem;
}

.result-item:last-child {
  border-bottom: none;
}

.status-badge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.status-ok { background: rgba(16, 185, 129, 0.15); color: var(--brand-emerald); }
.status-warn { background: rgba(245, 158, 11, 0.15); color: var(--brand-amber); }
.status-bad { background: rgba(244, 63, 94, 0.15); color: var(--brand-rose); }

/* Control Buttons & Actions */
.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 10px;
}

.cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 14px 20px;
  background: linear-gradient(180deg, #1e293b, #0f172a);
  border: 1px solid var(--surface-border-hover);
  border-radius: var(--radius-md);
  color: #fff;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.cta-button:hover {
  background: var(--surface-border-hover);
  border-color: #64748b;
}

.pdf-export-btn {
  background: rgba(6, 182, 212, 0.1);
  border: 1px solid rgba(6, 182, 212, 0.3);
  color: var(--brand-cyan);
}

.pdf-export-btn:hover {
  background: rgba(6, 182, 212, 0.2);
  border-color: var(--brand-cyan);
  color: #fff;
}

.ai-card {
  border: 1px solid rgba(139, 92, 246, 0.3) !important;
  background: linear-gradient(180deg, rgba(30, 27, 75, 0.35) 0%, rgba(15, 23, 42, 0.9) 100%) !important;
  box-shadow: var(--shadow-purple);
  padding: 32px !important;
}

.ai-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.ai-header-title {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #c4b5fd;
  font-size: 1.25rem;
  font-weight: 700;
}

.ai-pill {
  background: rgba(139, 92, 246, 0.2);
  border: 1px solid rgba(139, 92, 246, 0.35);
  color: #ddd6fe;
  font-size: 0.72rem;
  padding: 2px 8px;
  border-radius: 9999px;
  font-weight: 700;
}

.report {
  font-size: 0.92rem;
  color: #cbd5e1;
  line-height: 1.65;
}

/* ==========================================================================
   PRINT / PDF AUDIT EXPORT STYLESHEET
   ========================================================================== */
@media print {
  @page {
    margin: 1.2cm;
    size: A4 portrait;
  }

  body {
    background: #ffffff !important;
    color: #0f172a !important;
    font-size: 11pt;
  }

  /* Hide interactive scan controls, header buttons, inputs, & tickers */
  .app-nav,
  .hero,
  .scan-card,
  .feed-card,
  .action-grid,
  #quickCheckResult,
  #tabGroup,
  .cta-button {
    display: none !important;
  }

  .app-container {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Force white cards with clean black/gray borders */
  .card {
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: none !important;
    color: #0f172a !important;
    margin-bottom: 16px !important;
    break-inside: avoid;
  }

  .hero-grade-card {
    background: #f8fafc !important;
    border: 1px solid #cbd5e1 !important;
  }

  .hero-score-title {
    color: #0f172a !important;
  }

  .grade-ring-bg {
    stroke: #e2e8f0 !important;
  }

  .result-item {
    border-bottom: 1px solid #f1f5f9 !important;
    color: #1e293b !important;
  }

  /* Ensure badges print with high contrast */
  .status-ok {
    background: #ecfdf5 !important;
    color: #065f46 !important;
    border: 1px solid #a7f3d0 !important;
  }
  .status-warn {
    background: #fffbeb !important;
    color: #92400e !important;
    border: 1px solid #fde68a !important;
  }
  .status-bad {
    background: #fef2f2 !important;
    color: #991b1b !important;
    border: 1px solid #fecaca !important;
  }

  .ai-card {
    background: #faf5ff !important;
    border: 1px solid #d8b4fe !important;
    color: #1e1b4b !important;
  }

  .ai-header-title {
    color: #4c1d95 !important;
  }

  .report {
    color: #1e293b !important;
  }

  pre {
    background: #f1f5f9 !important;
    border: 1px solid #cbd5e1 !important;
    color: #0f172a !important;
  }
}
